# IfPlay API
IFPLAY_HOST=127.0.0.1
IFPLAY_PORT=8787
IFPLAY_DATA_DIR=.data
IFPLAY_MAX_CONCURRENT_TASKS=2

# `demo` generates a clearly labelled local sample without calling a model.
# `opengame` invokes the vendored OpenGame CLI.
IFPLAY_GENERATOR_MODE=demo

# Required acknowledgement for running OpenGame without a production sandbox.
# Only use for local, controlled testing.
IFPLAY_ALLOW_UNSANDBOXED_OPENGAME=false

# DeepSeek through OpenGame's OpenAI-compatible model interface.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# Alibaba Cloud Wanxiang image generation through OpenGame.
# OPENGAME_IMAGE_PROVIDER=tongyi
# OPENGAME_IMAGE_API_KEY=
# OPENGAME_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
# OPENGAME_IMAGE_MODEL=wan2.5-t2i-preview
