{
  "name": "ifplay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "setup:opengame": "npm --prefix vendor/opengame install && npm --prefix vendor/opengame run build",
    "test": "node --test test/*.test.mjs"
  }
}
